# ==============================================================================
# BACKEND - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# NUNCA commite o arquivo .env preenchido no Git!
# Para usar, crie uma cópia deste arquivo com o nome `.env` e preencha com suas credenciais do Neon.

# 1. Configuração do Neon PostgreSQL (Serverless)
# IMPORTANTE: A URL deve conter obrigatoriamente `?sslmode=require` para autenticação SSL segura com o Neon.
# Exemplo obtido no console do Neon (Connection Details -> JDBC):
# jdbc:postgresql://ep-silent-hill-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://<ENDPOINT_HOST_NEON>/<NOME_DO_BANCO>?sslmode=require
DB_USERNAME=<USUARIO_NEON>
DB_PASSWORD=<SENHA_NEON>

# Otimização de Pool de Conexões (HikariCP para Serverless)
DB_POOL_MAX=5
DB_POOL_MIN=2

# 2. Porta do Servidor Spring Boot
SERVER_PORT=8080

# 3. Chave Secreta JWT (Mínimo de 256 bits / 32+ caracteres)
JWT_SECRET=sua_chave_secreta_super_segura_com_mais_de_32_caracteres_vertex_tcc_2026
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# 4. CORS (Origens permitidas separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
