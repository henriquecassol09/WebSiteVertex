# ==============================================================================
# FRONTEND - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# No ambiente local com Vite Proxy, '/api' redireciona para 'http://localhost:8080/api'
# Em produção ou caso queira conectar diretamente sem proxy, defina a URL completa (ex: 'http://localhost:8080/api').

VITE_API_BASE_URL=/api
